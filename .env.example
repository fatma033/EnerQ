# OPENAI_API_KEY: Required for live OpenAI-powered agent reasoning.
# Without it, EnerQ automatically falls back to its deterministic
# reasoning engine (the app still runs and demos fully either way).
OPENAI_API_KEY="sk-..."

# OPENAI_MODEL: Which OpenAI chat model powers the agent's reasoning.
# Defaults to a small/fast model — swap for a larger one if you need
# deeper reasoning quality over cost/latency.
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this app is hosted (used for self-referential
# links if you deploy it). Not required for local development.
APP_URL="http://localhost:3000"
