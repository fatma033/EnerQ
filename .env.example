# OLLAMA_BASE_URL: Where the local Ollama server exposes its OpenAI-
# compatible API. Default is correct for a standard local Ollama install.
# Uses 127.0.0.1, not "localhost" — Node's fetch resolves "localhost" to
# IPv6 (::1) first, which Ollama doesn't listen on, causing a silent
# connection failure even though the server is genuinely running.
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"

# OLLAMA_MODEL: Which local model powers the agent's live reasoning.
# qwen2.5:3b-instruct is light and fast enough for a laptop demo (~2GB,
# runs fine on 8GB RAM / no GPU) while giving noticeably better Arabic
# quality than same-size Llama models -- Qwen's multilingual training
# data is stronger for Arabic specifically.
# Pull it first with: ollama pull qwen2.5:3b-instruct
OLLAMA_MODEL="qwen2.5:3b-instruct"

# Without Ollama running, EnerQ automatically falls back to its
# deterministic reasoning engine — the app still runs and demos fully.
# This is what happens automatically on a deployed server (Render, etc.),
# since there's no local Ollama for it to reach.

# --- Deploying and want genuine live-LLM answers instead of the ---
# --- deterministic fallback? Point these three at a free hosted, ---
# --- OpenAI-compatible provider instead of local Ollama: ---
#
# Groq (https://console.groq.com — free account, no card required):
#   OLLAMA_BASE_URL="https://api.groq.com/openai/v1"
#   OLLAMA_MODEL="llama-3.1-8b-instant"
#   LLM_API_KEY="gsk_..." (from console.groq.com/keys)
#
# LLM_API_KEY: the API key sent as the Bearer token. Ollama ignores it
# entirely (the SDK just requires a non-empty string), so it's safe to
# leave unset for local development.
# LLM_API_KEY="ollama"

# APP_URL: The URL where this app is hosted (used for self-referential
# links if you deploy it). Not required for local development.
APP_URL="http://localhost:3000"
