# OLLAMA_BASE_URL: Where the local Ollama server exposes its OpenAI-
# compatible API. Default is correct for a standard local Ollama install.
# Uses 127.0.0.1, not "localhost" — Node's fetch resolves "localhost" to
# IPv6 (::1) first, which Ollama doesn't listen on, causing a silent
# connection failure even though the server is genuinely running.
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"

# OLLAMA_MODEL: Which local model powers the agent's live reasoning.
# llama3.2:3b is a light, fast model well suited to a laptop demo.
# Pull it first with: ollama pull llama3.2:3b
OLLAMA_MODEL="llama3.2:3b"

# Without Ollama running, EnerQ automatically falls back to its
# deterministic reasoning engine — the app still runs and demos fully.

# APP_URL: The URL where this app is hosted (used for self-referential
# links if you deploy it). Not required for local development.
APP_URL="http://localhost:3000"
